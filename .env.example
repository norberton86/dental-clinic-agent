# LLM
LLM_PROVIDER=anthropic         # anthropic | openai | telnyx (Kimi via Telnyx inference)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Prompt caching is explicit for Anthropic (cache_control markers, applied in code) and
# AUTOMATIC for openai/telnyx. Switching to Kimi needs no caching code: LLM_PROVIDER=telnyx.
TELNYX_INFERENCE_MODEL=moonshotai/Kimi-K2.6   # used only when LLM_PROVIDER=telnyx (uses TELNYX_API_KEY)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# STT
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es           # NOT es-ES (Deepgram uses "es")

# TTS  (Deepgram Aura-2 reuses DEEPGRAM_API_KEY — no separate TTS key)
TTS_PROVIDER=deepgram          # deepgram | elevenlabs | azure
DEEPGRAM_TTS_VOICE=aura-2-carina-es   # Spanish Aura-2 (aura-2-<voice>-es); see voices at developers.deepgram.com/docs/tts-models
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=
# AZURE_VOICE_ID=es-ES-ElviraNeural

# Telnyx
TELNYX_API_KEY=                # Bearer API key (used by serializer + call-control tools)
# TELNYX_PUBLIC_KEY=           # Ed25519 public key — only if you add custom webhook verification
PUBLIC_HOST=                   # public host the runner is reached at (the `-x` value), e.g. xxxx.ngrok-free.app
PORT=8080

# Supabase
SUPABASE_URL=                  # e.g. https://uejbziokkozkyluxihfb.supabase.co
SUPABASE_SERVICE_KEY=

# Call routing
HUMAN_TRANSFER_NUMBER=         # clinic's real human line, E.164 (e.g. +34...)
DEFAULT_COUNTRY_CODE=+34       # fallback for phone normalization

# Email (SMTP) — optional appointment confirmation/reminder emails.
# Leave SMTP_HOST/EMAIL_FROM blank to disable (the agent will say email is unavailable).
# Gmail: host smtp.gmail.com, port 587, username = your address, password = an App Password.
SMTP_HOST=                     # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                 # app password / API key, NOT your login password
EMAIL_FROM=                    # the From address (e.g. citas@clinica.com)
EMAIL_FROM_NAME=Clínica Dental Smile
SMTP_USE_TLS=true

# Logging
LOG_LEVEL=INFO
